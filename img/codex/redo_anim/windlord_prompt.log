The generated draft has all four poses, but its canvas and pixel grid differ from the reference. I’ll fit it to four 512×512 cells and reuse the reference’s head and feet so those details stay fixed.
exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command '$ErrorActionPreference = '"'Stop'
Add-Type -AssemblyName System.Drawing
"'$source = '"'C:/Users/Home/.codex/generated_images/01a21c44-0c13-78b3-8067-8a7055496a0c/exec-d20cc44b-66df-4b49-836e-72bb59cb72d8.png'
"'$target = Join-Path (Resolve-Path -LiteralPath '"'img/codex/redo_anim').Path 'windlord_atk_src.png'
"'$reference = [Drawing.Bitmap]::new((Resolve-Path -LiteralPath '"'img/codex/redo_anim/windlord_x8.png').Path)
"'$generated = [Drawing.Bitmap]::new($source)
$sheet = [Drawing.Bitmap]::new(2048,512,[Drawing.Imaging.PixelFormat]::Format24bppRgb)
$graphics = [Drawing.Graphics]::FromImage($sheet)
$magenta = [Drawing.Color]::Magenta
$graphics.Clear($magenta)
$brushes = @{}
$palette = @{}
$matchCache = @{}
$base = [Drawing.Color[,]]::new(64,64)
for ($y=0; $y -lt 64; $y++) {
  for ($x=0; $x -lt 64; $x++) {
    $sample = $reference.GetPixel(8*$x+4, 8*$y+4)
    if ($sample.R -gt 250 -and $sample.G -gt 250 -and $sample.B -gt 250) { $sample = $magenta }
    else { $palette[$sample.ToArgb()] = $sample }
    $base[$x,$y]=$sample
  }
}
$swatches = @($palette.Values)
$anchorX = @(239,786,1328,1868)
for ($frame=0; $frame -lt 4; $frame++) {
  for ($y=15; $y -lt 64; $y++) {
    for ($x=8; $x -le 54; $x++) {
      $color = $base[$x,$y]
      if ($y -ge 38 -and $y -lt 55 -and $x -ge 19) {
        $sampleY = $y
        if ($frame -eq 0 -and $y -ge 40) {
          $sampleY = $y + $(if ($y -eq 40 -or $y -ge 53) {1} else {2})
        }
        $sampleX = $x
        if ($frame -eq 2 -and $y -ge 39 -and $y -le 43 -and $x -ge 35) {
          # Copy the horizontal fore-end from aim exactly two native pixels to the left.
          $sampleX = $x+2
          $sampleFrame = 1
        } else { $sampleFrame = $frame }
        $sample = $generated.GetPixel([int]($anchorX[$sampleFrame]+11.12*($sampleX-27)), [int](102+11.20*($sampleY-15)))
        if ($frame -eq 2 -and $y -eq 39 -and $x -ge 35) {
          # Restore the empty dark rail where the loaded bolt crosses it.
          $sample = $generated.GetPixel([int]($anchorX[2]+11.12*($x-27)), [int](102+11.20*(40-15)))
          if ($x -gt 46) { $sample = $magenta }
          elseif ($sample.R -gt 100 -and $sample.G -gt 90 -and $sample.B -gt 90) { $sample = $base[36,38] }
        }
        if ($sample.R -gt 140 -and $sample.B -gt 140 -and $sample.G -lt 105) {
          $color = $magenta
        } else {
          $key = $sample.ToArgb()
          if (!$matchCache.ContainsKey($key)) {
            $minimum = [int]::MaxValue
            $nearest = $sample
            foreach ($swatch in $swatches) {
              $red = $sample.R - $swatch.R
              $green = $sample.G - $swatch.G
              $blue = $sample.B - $swatch.B
              $distance = $red*$red + $green*$green + $blue*$blue
              if ($distance -lt $minimum) { $minimum = $distance; $nearest = $swatch }
            }
            $matchCache[$key] = $nearest
          }
          $color = $matchCache[$key]
        }
      }
      if ($color.ToArgb() -eq $magenta.ToArgb()) { continue }
      $key = $color.ToArgb()
      if (!$brushes.ContainsKey($key)) { $brushes[$key] = [Drawing.SolidBrush]::new($color) }
      $graphics.FillRectangle($brushes[$key], 512*$frame+8*$x, 8*$y, 8, 8)
    }
  }
}
$graphics.Dispose()
$brushes.Values | ForEach-Object { $_.Dispose() }
$encoded = [IO.MemoryStream]::new()
$sheet.Save($encoded,[Drawing.Imaging.ImageFormat]::Png)
Copy-Item -LiteralPath $source -Destination $target
[IO.File]::WriteAllBytes($target,$encoded.ToArray())
$encoded.Dispose()
$sheet.Dispose()
$generated.Dispose()
$reference.Dispose()
