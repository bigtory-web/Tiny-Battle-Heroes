function Scale-Sheet([int]$zoom) {
    $sheet=[Drawing.Bitmap]::new(256*$zoom,64*$zoom,[Drawing.Imaging.PixelFormat]::Format24bppRgb)
    $graphics=[Drawing.Graphics]::FromImage($sheet)
    $graphics.InterpolationMode=[Drawing.Drawing2D.InterpolationMode]::NearestNeighbor
    $graphics.PixelOffsetMode=[Drawing.Drawing2D.PixelOffsetMode]::Half
    $graphics.DrawImage($sprite,0,0,$sheet.Width,$sheet.Height)
    $graphics.Dispose()
    return $sheet
}

