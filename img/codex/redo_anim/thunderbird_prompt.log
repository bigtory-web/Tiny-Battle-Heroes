"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command 'Add-Type -AssemblyName System.Drawing
$base = (Resolve-Path -LiteralPath '"'img/codex/redo_anim').Path
"'$files = @('"'thunderbird_x8.png','thunderbird_atk_src_v1.png')
foreach ("'$file in $files) {
  $b = [System.Drawing.Bitmap]::new((Join-Path $base $file))
  for ($frame=0;$frame -lt $b.Width/512;$frame++) {
    "$file frame $frame"
    '"'   ' + (-join (0..63 | ForEach-Object { [int][Math]::Floor("'$_/10) }))
    '"'   ' + (-join (0..63 | ForEach-Object { "'$_ % 10 }))
    for ($y=15;$y -lt 64;$y++) {
      $line = for ($x=0;$x -lt 64;$x++) {
        $p=$b.GetPixel(($frame*64+$x)*8+4,$y*8+4)
        if (($p.R -eq 255 -and $p.B -eq 255) -or ($p.R -gt 250 -and $p.G -gt 250 -and $p.B -gt 250)) {'"' '}
        elseif ("'$p.B -gt 155 -and $p.R -lt 100) {'"'C'}
        elseif ("'$p.B -gt $p.R+10) {'"'N'}
        elseif ("'$p.R -lt 100) {'"'#'}
        elseif ("'$p.R -gt 210 -and $p.G -gt 218) {'"'w'}
        elseif ("'$p.R -gt 210 -and $p.B -gt 115) {'"'s'}
        elseif ("'$p.R -gt 210 -and $p.G -gt 140) {'"'G'}
        else {'o'}
      }
      '{0:D2} {1}' -f "'$y,(-join $line)
    }
  }
  $b.Dispose()
}' in C:\Users\Home\Downloads\방치형RPG_테스트베드
