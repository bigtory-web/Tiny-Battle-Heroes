function Get-Swatch([Drawing.Color]$c){
  if($c.R -gt 125 -and $c.B -gt 115 -and $c.G -lt 115 -and $c.B -gt $c.G*1.50 -and $c.R -gt $c.G*1.50){ return -1 }
