  for($i=0;$i -lt $palette.Length;$i++){
    $anchor=$palette[$i].Source
    $dr=$anchor.R-$c.R
    $dg=$anchor.G-$c.G
    $db=$anchor.B-$c.B
    $d=$dr*$dr + 2*$dg*$dg + $db*$db
    if($d -lt $bestDist){ $bestDist=$d; $best=$i }
  }
  return $best
}
