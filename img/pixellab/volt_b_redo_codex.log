using System;
using System.Drawing;
using System.Drawing.Imaging;
using System.Collections.Generic;

public static class SpriteExport {
    private static bool IsMagenta(Color pixel) {
        return pixel.R > 125 && pixel.B > 125
            && pixel.R > pixel.G * 1.45 && pixel.B > pixel.G * 1.45
            && Math.Abs(pixel.R - pixel.B) < 95;
    }

    private static Rectangle Bounds(Bitmap bitmap, Func<Color, bool> isBackground) {
        int left = bitmap.Width, top = bitmap.Height, right = -1, bottom = -1;
        for (int y = 0; y < bitmap.Height; y++) {
            for (int x = 0; x < bitmap.Width; x++) {
                if (isBackground(bitmap.GetPixel(x, y))) continue;
                left = Math.Min(left, x);
                top = Math.Min(top, y);
                right = Math.Max(right, x);
                bottom = Math.Max(bottom, y);
            }
        }
        return Rectangle.FromLTRB(left, top, right + 1, bottom + 1);
    }

    private static int Distance(Color first, Color second) {
        int r = first.R - second.R, g = first.G - second.G, b = first.B - second.B;
        return r*r + g*g + b*b;
    }

    private static Color[] Palette(List<Color> pixels, int count) {
        var centers = new Color[count];
        var errors = new int[pixels.Count];
        for (int i = 0; i < errors.Length; i++) errors[i] = int.MaxValue;
        centers[0] = pixels[0];
        for (int c = 1; c < count; c++) {
            double farthest = -1;
            int sample = 0;
            for (int i = 0; i < pixels.Count; i++) {
                errors[i] = Math.Min(errors[i], Distance(pixels[i], centers[c-1]));
                double priority = errors[i] * (0.7 + 0.3 * ((i * 3571 % 1009) / 1008.0));
                if (priority > farthest) { farthest = priority; sample = i; }
            }
            centers[c] = pixels[sample];
        }
        for (int step = 0; step < 12; step++) {
            var sums = new int[count, 4];
            foreach (Color pixel in pixels) {
                int c = Nearest(pixel, centers);
                sums[c, 0] += pixel.R;
                sums[c, 1] += pixel.G;
                sums[c, 2] += pixel.B;
                sums[c, 3]++;
            }
            for (int c = 0; c < count; c++) {
                int weight = sums[c, 3];
                if (weight > 0) centers[c] = Color.FromArgb(sums[c, 0]/weight, sums[c, 1]/weight, sums[c, 2]/weight);
            }
        }
        return centers;
    }

    private static int Nearest(Color pixel, Color[] palette) {
        int best = 0, distance = int.MaxValue;
        for (int c = 0; c < palette.Length; c++) {
            int error = Distance(pixel, palette[c]);
            if (error < distance) { distance = error; best = c; }
        }
        return best;
    }

    public static string Save(string source, string reference, string destination) {
        const int side = 1024, block = 8, cells = side / block;
        using (var original = new Bitmap(source))
        using (var knight = new Bitmap(reference))
        using (var output = new Bitmap(side, side, PixelFormat.Format24bppRgb))
        using (var graphics = Graphics.FromImage(output)) {
            int knightBackground = knight.GetPixel(0, 0).ToArgb();
            Rectangle template = Bounds(knight, pixel => pixel.ToArgb() "'!= knightBackground
                ? Math.Abs(pixel.R - 58) < 12 && Math.Abs(pixel.G - 125) < 12 && Math.Abs(pixel.B - 68) < 12
                : true);
            Rectangle silhouette = Bounds(original, IsMagenta);
            double scale = Math.Min(
                side * template.Width / (double)knight.Width / silhouette.Width,
                side * template.Height / (double)knight.Height / silhouette.Height);
            double centerX = silhouette.Left + silhouette.Width / 2.0;
            double centerY = silhouette.Top + silhouette.Height / 2.0;
            var sampled = new Color[cells, cells];
            var foreground = new List<Color>();
            for (int y = 0; y < cells; y++) {
                for (int x = 0; x < cells; x++) {
                    int used = 0, r = 0, g = 0, b = 0;
                    for (int j = -1; j <= 1; j++) {
                        for (int i = -1; i <= 1; i++) {
                            int sx = (int)Math.Floor(centerX + (x * block + block/2.0 + i * 2 - side/2.0) / scale);
                            int sy = (int)Math.Floor(centerY + (y * block + block/2.0 + j * 2 - side/2.0) / scale);
                            if (sx < 0 || sy < 0 || sx >= original.Width || sy >= original.Height) continue;
                            Color pixel = original.GetPixel(sx, sy);
                            if (IsMagenta(pixel)) continue;
                            r += pixel.R; g += pixel.G; b += pixel.B; used++;
                        }
                    }
                    if (used < 5) continue;
                    Color color = Color.FromArgb(r/used, g/used, b/used);
                    sampled[x, y] = color;
                    foreground.Add(color);
                }
            }

            Color[] palette = Palette(foreground, 34);
            var brushes = new SolidBrush[palette.Length];
            try {
                for (int c = 0; c < brushes.Length; c++) brushes[c] = new SolidBrush(palette[c]);
                graphics.Clear(Color.Magenta);
                for (int y = 0; y < cells; y++) {
                    for (int x = 0; x < cells; x++) {
                        Color pixel = sampled[x, y];
                        if (pixel.IsEmpty) continue;
                        graphics.FillRectangle(brushes[Nearest(pixel, palette)], x * block, y * block, block, block);
                    }
                }
                graphics.Flush();
                output.Save(destination, ImageFormat.Png);
            } finally {
                foreach (SolidBrush brush in brushes) if (brush != null) brush.Dispose();
            }
            Rectangle finalBounds = Bounds(output, pixel => pixel.ToArgb() == Color.Magenta.ToArgb());
            return String.Format("Knight bounds: {0}; exported sprite bounds: {1}; output: {2} x {3}", template, finalBounds, output.Width, output.Height);
        }
    }
}
