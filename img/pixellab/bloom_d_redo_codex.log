using System;
using System.Drawing;
using System.Drawing.Imaging;
using System.Globalization;
using System.Linq;
public static class SpriteExport {
 static readonly Color Magenta = Color.FromArgb(255, 0, 255);
 static readonly Color[] Palette = (
   \"39150B 501B0D 6A2412 862B19 AB4022 C34D2A B9542B \" +
   \"262538 272840 30334F 53542B 757733 7D8839 8D9E3D A7BD3E AAC744 \" +
   \"9E6120 CE801A EAA719 F7B721 FFC72E F3A575 F9B889 FBCD97 FBD5A7 FDE6B8 FFF2CF\"
 ).Split(' ').Select(hex => Color.FromArgb(int.Parse(hex.Substring(0,2), NumberStyles.HexNumber),
   int.Parse(hex.Substring(2,2), NumberStyles.HexNumber),
   int.Parse(hex.Substring(4,2), NumberStyles.HexNumber))).ToArray();

 static Color ExportColor(Color c) {
  if (c.R > 155 && c.B > 100 && c.B > c.G * 1.4 && c.B > c.R * 0.68) return Magenta;
  int bestDistance = int.MaxValue;
  Color best = Palette[0];
  foreach (Color p in Palette) {
   int r = c.R - p.R, g = c.G - p.G, b = c.B - p.B;
   int distance = r*r + 2*g*g + b*b;
   if (distance < bestDistance) { best = p; bestDistance = distance; }
  }
  return best;
 }

 public static void Save(string source, string target) {
  using (var input = new Bitmap(source))
  using (var output = new Bitmap(1024, 1024, PixelFormat.Format24bppRgb)) {
   using (var canvas = Graphics.FromImage(output)) {
    canvas.Clear(Magenta);
    for (int y = 0; y < 46; y++) {
     for (int x = 0; x < 32; x++) {
      Color c = ExportColor(input.GetPixel((int)Math.Round(324 + x * 19.45),
                                           (int)Math.Round(156 + y * 19.64)));
      if (c.ToArgb() == Magenta.ToArgb()) continue;
      using (var brush = new SolidBrush(c)) canvas.FillRectangle(brush, 384 + x * 8, 328 + y * 8, 8, 8);
     }
    }
   }
   using (var file = System.IO.File.Open(target, System.IO.FileMode.CreateNew)) {
    output.Save(file, ImageFormat.Png);
   }
  }
 }

 public static void Verify(string file, bool sprite) {
  using (var b = new Bitmap(file)) {
   Color background = b.GetPixel(0, 0);
   int left=b.Width, right=-1, top=b.Height, bottom=-1, offGrid=0;
   for (int y=0; y<b.Height; y++) for (int x=0; x<b.Width; x++) {
    int c=b.GetPixel(x,y).ToArgb();
    if (c "'!= background.ToArgb()) {
     left=Math.Min(left,x); right=Math.Max(right,x); top=Math.Min(top,y); bottom=Math.Max(bottom,y);
    }
    if (sprite && c!=b.GetPixel(x&~7,y&~7).ToArgb()) offGrid++;
   }
   Console.WriteLine("{0}x{1}, background {2}, bounds ({3},{4}) through ({5},{6}), footprint {7}x{8}, off-grid pixels {9}",
      b.Width,b.Height,background.Name,left,top,right,bottom,right-left+1,bottom-top+1,offGrid);
   if (sprite && (b.Width!=1024 || b.Height!=1024 || background.ToArgb()!=Magenta.ToArgb() || offGrid!=0))
      throw new InvalidOperationException("Output validation failed.");
  }
 }
}
